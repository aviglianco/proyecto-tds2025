program
{
        integer x = 1;
        bool z = (2+1) == 3 && true;

        integer get_int() extern;

        integer print_int(integer i) extern;

        integer inc(integer x) {
                integer y = x + 1;
                return y;
        }

        void main() {
          integer y = 0;
          y = get_int();

          if (!(y > 100)) then {
            while (y < 100) {
              y = inc(y);
            }
          } else {
            print_int(y);
          }

          print_int(y);
        }
}
